    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(t), '[]') as \"Bảng Dữ Liệu Tuần\"\nFROM (\n    SELECT \n        u.user_name as \"Tên Người Dùng\",\n        u.telegram_id as \"Chat ID\",\n        CASE EXTRACT(DOW FROM t.date)\n            WHEN 0 THEN 'Chủ Nhật' WHEN 1 THEN 'Thứ 2' WHEN 2 THEN 'Thứ 3'\n            WHEN 3 THEN 'Thứ 4' WHEN 4 THEN 'Thứ 5' WHEN 5 THEN 'Thứ 6'\n            WHEN 6 THEN 'Thứ 7'\n        END as \"Thứ\",\n        t.description as \"Mô Tả\",\n        SUM(t.amount)::BIGINT as \"Số Tiền\", \n        COUNT(*) as \"Số Lần\",\n        t.transaction_type as \"Loại Giao Dịch\",\n        MAX(c.category_name) as \"Danh Mục\",\n        t.date as \"Ngày Giao Dịch\"\n    FROM transaction_service.transactions t\n    JOIN account_service.accounts a ON t.account_id = a.account_id\n    JOIN user_service.users u ON a.user_id = u.user_id \n    JOIN category_service.categories c ON t.category_id = c.category_id\n    WHERE \n        u.telegram_id IS NOT NULL\n        AND a.user_id = '{{ $json.user_id }}'\n        AND t.date >= date_trunc('week', NOW() AT TIME ZONE 'Asia/Ho_Chi_Minh') \n        AND t.date < date_trunc('week',  NOW() AT TIME ZONE 'Asia/Ho_Chi_Minh') + INTERVAL '1 week'\n    GROUP BY \n        u.user_name,\n        u.telegram_id,\n        \"Thứ\", \n        t.description, \n        t.transaction_type, \n        c.category_name,\n        t.date,\n        t.date::DATE \n    ORDER BY t.date::DATE ASC, \"Số Tiền\" DESC\n) t;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -720,
        304
      ],
      "id": "6298c25b-a557-4228-aa85-8c60f766d17e",
      "name": "Cảnh_Báo_Tuần",
      "credentials": {
        "postgres": {
          "id": "vTX9nKzAicH6O00I",
          "name": "Postgres account"
        }
      }
