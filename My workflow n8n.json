    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(t), '[]') as du_lieu_quy\nFROM (\n    SELECT \n        'Tháng ' || EXTRACT(MONTH FROM date) as thang,\n        SUM(CASE WHEN transaction_type = 'income' THEN amount ELSE 0 END) as thu,\n        SUM(CASE WHEN transaction_type = 'expense' THEN amount ELSE 0 END) as chi\n    FROM transactions\n    WHERE date >= date_trunc('quarter', CURRENT_DATE - INTERVAL '3 months')\n      AND date < date_trunc('quarter', CURRENT_DATE)\n    GROUP BY thang\n    ORDER BY thang\n) t;",
        "options": {}
      },
