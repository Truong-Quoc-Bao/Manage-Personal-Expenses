    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    TO_CHAR(NOW() AT TIME ZONE 'Asia/Ho_Chi_Minh', 'DD/MM/YYYY') AS \"Ngày VN\",\n    COALESCE(SUM(t.amount), 0)::int as \"Tổng Chi Hôm Nay\",\n    500000 as \"Hạn Mức\",\n    '{{ $json.user_id }}' as \"ID\",\n    '{{ $json.telegram_id }}' as \"Chat ID\",\n    '{{ $json.user_name }}' as \"Tên Người Dùng\"\nFROM user_service.users u\nLEFT JOIN account_service.accounts a ON u.user_id = a.user_id\nLEFT JOIN transaction_service.transactions t ON a.account_id = t.account_id \n    AND t.date::DATE = (NOW() AT TIME ZONE 'Asia/Ho_Chi_Minh')::DATE\n    AND t.transaction_type = 'expense'\nWHERE u.user_id = '{{ $json.user_id }}'\nGROUP BY u.user_id, u.user_name;",
        "options": {}
      },
