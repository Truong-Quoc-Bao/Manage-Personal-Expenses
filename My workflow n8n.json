    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    json_agg(t) as du_lieu_bao_cao,\n    SUM(CASE WHEN transaction_type = 'income' THEN amount ELSE 0 END) as tong_thu,\n    SUM(CASE WHEN transaction_type = 'expense' THEN amount ELSE 0 END) as tong_chi\nFROM (\n    SELECT description, amount, transaction_type, date, category_id \n    FROM transactions\n    WHERE \n        -- Tự động lấy dữ liệu của THÁNG TRƯỚC\n        date >= date_trunc('month', CURRENT_DATE - INTERVAL '1 month')\n        AND date < date_trunc('month', CURRENT_DATE)\n) t;",
        "options": {}
      },
