generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["category_service"]
}

model Icon {
  icon_id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String     @unique @db.VarChar(50)
  icon_code  String     @db.VarChar(100)
  category   String?    @db.VarChar(50)
  tags       String[]
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  categories Category[]

  @@map("icons")
  @@schema("category_service")
}

model Category {
  category_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  category_name String   @db.VarChar(100)
  type          String?  @db.VarChar(50)
  icon_id       String?  @db.Uuid
  color         String?  @db.VarChar(50)
  is_system     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  icon          String? @db.VarChar(255)
  Icon          Icon?    @relation(fields: [icon_id], references: [icon_id])

  @@map("categories")
  @@schema("category_service")
}
